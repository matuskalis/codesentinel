{
  "name": "codesentinel",
  "version": "0.1.0",
  "description": "Deterministic security scanner for startup-stack code — catch secrets, env leaks, and misconfigurations before they ship",
  "type": "module",
  "license": "MIT",
  "author": "Matus Kalis",
  "repository": {
    "type": "git",
    "url": "https://github.com/matuskalis/codesentinel.git"
  },
  "homepage": "https://github.com/matuskalis/codesentinel",
  "keywords": [
    "security",
    "scanner",
    "secrets",
    "cli",
    "github-action",
    "nextjs",
    "supabase",
    "stripe"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "codesentinel": "./dist/codesentinel.mjs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node --import tsx worker/index.ts",
    "worker:dev": "node --watch --import tsx worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "cli:build": "node --import tsx scripts/build-cli.ts",
    "cli:dev": "node --import tsx src/cli/index.ts",
    "prepublishOnly": "npm run cli:build"
  },
  "devDependencies": {
    "@octokit/app": "^15.0.0",
    "@octokit/rest": "^21.0.0",
    "@octokit/webhooks": "^13.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bullmq": "^5.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "drizzle-kit": "^0.30.0",
    "drizzle-orm": "^0.38.0",
    "esbuild": "^0.24.0",
    "ioredis": "^5.4.0",
    "jose": "^5.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^3.23.0"
  }
}
